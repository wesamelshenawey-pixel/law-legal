rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core function for authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role-based function (assuming role is stored in token or we just do simple auth)
    // To avoid complex custom claims for this prototype, we'll allow authenticated users to read/write.
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /cases/{caseId} {
      allow read, write: if isAuthenticated();
    }

    match /keepNotes/{noteId} {
      allow read, write: if isAuthenticated();
    }
  }
}
